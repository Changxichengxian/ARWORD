config_version=5

[application]
boot_splash/bg_color=Color(0.027, 0.11, 0.18, 1)
boot_splash/image="res://assets/icon-foreground.png"
boot_splash/fullsize=false
config/name="词屿"
config/version="0.5.0"
run/max_fps=60
config/icon="res://assets/icon.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="竖屏小星球 · 采集与英语"

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=1024
scaling_3d/scale=0.85
environment/defaults/default_clear_color=Color(0.49,0.76,0.83,1)

[audio]
driver/enable_input=false

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=60

[debug]
gdscript/warnings/integer_division=0
